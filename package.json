{
  "name": "webapp-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "play": "vite --mode play --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && CLOUDFLARE_ENV=staging DEPLOY_ENV=STAGING vite build",
    "build:prod": "tsc -b && CLOUDFLARE_ENV=production DEPLOY_ENV=PRODUCTION vite build",
    "lint": "oxlint",
    "test": "node --test",
    "preview": "npm run build && vite preview",
    "deploy:staging": "npm run build:staging && wrangler deploy --env staging",
    "deploy:prod": "npm run build:prod && wrangler deploy --env production"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.139.0"
  }
}
