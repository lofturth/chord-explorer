{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp-starter",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "name": "webapp-starter-staging"
    },
    "production": {
      "name": "webapp-starter-production"
    }
  }
}
